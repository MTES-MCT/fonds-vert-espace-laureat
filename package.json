{
  "name": "fonds-vert-espace-laureat",
  "version": "0.1.0",
  "packageManager": "npm@11.16.0",
  "engines": {
    "node": "24",
    "npm": "11.16.0"
  },
  "scripts": {
    "dev": "react-dsfr update-icons && npm run codegen && next dev",
    "dev:test": "react-dsfr update-icons && npm run codegen && NEXT_DIST_DIR=.next-test NEXT_TEST_PROXY=1 NODE_ENV=development NODE_OPTIONS=--require=./scripts/disable-next-test-client-request-interceptor.cjs dotenv -e .env.test.example -e .env.test -- next dev -p 4000",
    "build": "react-dsfr update-icons && npm run codegen && next build",
    "start": "next start",
    "lint": "oxlint --type-aware src tests",
    "lint:fix": "oxlint --type-aware --fix src tests",
    "test": "npm run test:e2e --",
    "test:e2e": "NODE_ENV=test dotenv -e .env.test.example -e .env.test -- playwright test --project=chromium",
    "test:e2e:ui": "NODE_ENV=test dotenv -e .env.test.example -e .env.test -- playwright test --ui",
    "test:db:setup": "node tests/setup-test-db.mjs",
    "codegen": "dotenv -e .env -- node scripts/codegen.mjs",
    "codegen:watch": "npm run codegen -- --watch",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:setup": "node scripts/setup-dev-db.mjs",
    "db:generate": "drizzle-kit generate --config drizzle.config.ts",
    "db:migrate": "drizzle-kit migrate --config drizzle.config.ts",
    "db:migrate:deploy": "node scripts/migrate-production.mjs",
    "db:studio": "drizzle-kit studio --config drizzle.config.ts",
    "codegen:corrections": "openapi-typescript openapi/corrections.json -o src/api/generated/corrections-api.d.ts",
    "check:corrections": "npm run codegen:corrections -- --check",
    "test:corrections-api": "dotenv -e tests/fixtures/corrections-api.env -- npm run test:e2e -- tests/corrections-api.spec.ts --workers=1"
  },
  "overrides": {
    "postcss-url": {
      "minimatch": "^5.1.6"
    },
    "@ardatan/relay-compiler": {
      "immutable": "^4.3.8"
    },
    "brace-expansion@1": "1.1.21",
    "lodash": "^4.17.24"
  },
  "dependencies": {
    "@codegouvfr/react-dsfr": "1.32.1",
    "@tidyjs/tidy": "^2.5.2",
    "date-fns": "^4.1.0",
    "drizzle-orm": "1.0.0-rc.4-5d5b77c",
    "fast-csv": "^5.0.5",
    "graphql": "^16.13.1",
    "graphql-request": "^7.4.0",
    "iron-session": "^8.0.4",
    "next": "16.3.8",
    "openid-client": "^6.8.8",
    "postcss-import": "^16.1.1",
    "postcss-url": "^10.1.3",
    "postgres": "3.4.9",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "sharp": "^0.35.3",
    "sonner": "^2.0.7"
  },
  "devDependencies": {
    "@graphql-codegen/client-preset": "6.2.3",
    "@graphql-codegen/core": "6.2.2",
    "@graphql-tools/graphql-tag-pluck": "8.3.41",
    "@parcel/watcher": "^2.5.6",
    "@playwright/test": "1.58.2",
    "@tailwindcss/postcss": "^4.2.1",
    "@types/node": "^24",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "dotenv-cli": "^8.0.0",
    "drizzle-kit": "1.0.0-rc.4-5d5b77c",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-readable-tailwind": "^3.0.0",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "msw": "^2.12.10",
    "openapi-typescript": "7.13.0",
    "oxlint": "1.88.0",
    "oxlint-tsgolint": "7.0.2004",
    "postcss": "^8",
    "prettier": "3.5.3",
    "sass": "^1.97.3",
    "tailwindcss": "^4.2.1",
    "typescript": "^5.9.3",
    "yaml": "2.9.1"
  }
}
