{
  "openapi": "3.1.0",
  "info": {
    "title": "Fonds Vert — corrections",
    "version": "1.0.0"
  },
  "paths": {
    "/api/v1/corrections": {
      "get": {
        "operationId": "getCorrections",
        "description": "Exporte les corrections en plusieurs pages. Faites le premier appel sans curseur, puis utilisez next_cursor pour lire les pages suivantes. L’export reste disponible pendant 24 h et son contenu ne change pas pendant la lecture. Un nouvel export peut être créé une fois par minute. L’accès nécessite une clé machine et une adresse IP autorisée, via HTTPS.",
        "security": [
          {
            "MachineKey": []
          }
        ],
        "parameters": [
          {
            "name": "page_size",
            "in": "query",
            "description": "Nombre de corrections par page. À préciser uniquement au premier appel, sans cursor.",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000,
              "default": 100
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "description": "Valeur reçue dans next_cursor, à réutiliser sans modification.",
            "schema": {
              "type": "string",
              "maxLength": 64,
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}:(0|[1-9][0-9]{0,9})$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Une page de corrections.",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CorrectionPage"
                }
              }
            }
          },
          "400": {
            "description": "Paramètres invalides",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "401": {
            "description": "Clé machine absente ou invalide",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "403": {
            "description": "Origine réseau refusée",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "404": {
            "description": "Export ou page introuvable. Recommencez sans curseur.",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "405": {
            "description": "Méthode non autorisée",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "410": {
            "description": "Export expiré. Recommencez sans curseur.",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "429": {
            "description": "Création trop fréquente ou déjà en cours",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              },
              "Retry-After": {
                "schema": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "503": {
            "description": "Service indisponible",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "MachineKey": {
        "type": "http",
        "scheme": "bearer",
        "description": "Clé d’accès à l’API. La connexion ProConnect ne permet pas d’utiliser cette API."
      }
    },
    "schemas": {
      "Correction": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "dossier_number",
          "champ",
          "valeur_corrigee",
          "date_correction"
        ],
        "properties": {
          "dossier_number": {
            "type": "integer"
          },
          "champ": {
            "type": "string"
          },
          "valeur_corrigee": {
            "oneOf": [
              {
                "type": "number"
              },
              {
                "type": "string"
              },
              {
                "type": "boolean"
              },
              {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            ]
          },
          "date_correction": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "CorrectionPage": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "corrections",
          "next_cursor",
          "generated_at",
          "expires_at",
          "total_count"
        ],
        "properties": {
          "corrections": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Correction"
            }
          },
          "next_cursor": {
            "description": "Curseur de la page suivante. null indique la fin de l’export.",
            "type": [
              "string",
              "null"
            ]
          },
          "generated_at": {
            "description": "Date de début de préparation de l’export.",
            "type": "string",
            "format": "date-time"
          },
          "expires_at": {
            "description": "Date limite pour lire cet export.",
            "type": "string",
            "format": "date-time"
          },
          "total_count": {
            "description": "Nombre total de corrections dans l’export, toutes pages comprises.",
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "ApiError": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "string",
            "enum": [
              "invalid_request",
              "unauthorized",
              "forbidden",
              "missing",
              "expired",
              "method_not_allowed",
              "rate_limited",
              "unavailable"
            ]
          }
        }
      }
    }
  }
}
