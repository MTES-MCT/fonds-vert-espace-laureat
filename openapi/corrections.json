{
  "openapi": "3.1.0",
  "info": {
    "title": "Fonds Vert — corrections",
    "version": "1.0.0"
  },
  "paths": {
    "/api/v1/corrections": {
      "get": {
        "operationId": "getCorrections",
        "description": "Sans curseur, crée un export conservé 24 h. Une création au plus par minute, globalement. Avec curseur, lit une page existante. Aucun filtre métier. HTTPS obligatoire à l’entrée publique, IP partenaire autorisée et attestée par le proxy requis.",
        "security": [
          {
            "MachineKey": []
          }
        ],
        "parameters": [
          {
            "name": "page_size",
            "in": "query",
            "description": "Premier appel seulement ; incompatible avec cursor.",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000,
              "default": 100
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "description": "Curseur opaque reçu dans next_cursor, à réutiliser sans modification.",
            "schema": {
              "type": "string",
              "maxLength": 64,
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}:[0-9]{1,10}$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Page immuable. total_count compte toutes les corrections de cet export ; generated_at marque le début de préparation, pas l’instant exact du snapshot SQL.",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CorrectionPage"
                }
              }
            }
          },
          "400": {
            "description": "Paramètres invalides",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "401": {
            "description": "Clé machine absente ou invalide",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "403": {
            "description": "Origine réseau refusée",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "404": {
            "description": "Export ou page absent ; recommencer un export",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "405": {
            "description": "Méthode non autorisée",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "410": {
            "description": "Export expiré ; recommencer un export",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "429": {
            "description": "Création trop fréquente ou déjà en cours",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              },
              "Retry-After": {
                "schema": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "503": {
            "description": "Configuration incomplète ou service indisponible",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "MachineKey": {
        "type": "http",
        "scheme": "bearer",
        "description": "Clé machine dédiée ; une session utilisateur ne donne aucun accès."
      }
    },
    "schemas": {
      "Correction": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "dossier_number",
          "champ",
          "valeur_corrigee",
          "date_correction"
        ],
        "properties": {
          "dossier_number": {
            "type": "integer"
          },
          "champ": {
            "type": "string"
          },
          "valeur_corrigee": {
            "oneOf": [
              {
                "type": "number"
              },
              {
                "type": "string"
              },
              {
                "type": "boolean"
              },
              {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            ]
          },
          "date_correction": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "CorrectionPage": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "corrections",
          "next_cursor",
          "generated_at",
          "expires_at",
          "total_count"
        ],
        "properties": {
          "corrections": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Correction"
            }
          },
          "next_cursor": {
            "type": [
              "string",
              "null"
            ]
          },
          "generated_at": {
            "type": "string",
            "format": "date-time"
          },
          "expires_at": {
            "type": "string",
            "format": "date-time"
          },
          "total_count": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "ApiError": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "string",
            "enum": [
              "invalid_request",
              "unauthorized",
              "forbidden",
              "missing",
              "expired",
              "method_not_allowed",
              "rate_limited",
              "unavailable"
            ]
          }
        }
      }
    }
  }
}
